#!/bin/sh
#
# Writes the What's new entry for the commit that just landed on main.
#
# Enable with `npm run hooks:install` (sets core.hooksPath to this directory).
# Runs after the commit exists, so it can never block or fail one: the worst
# case is no entry, and the next run picks up the commits it missed.

# The commit this script makes would otherwise trigger this hook again.
[ "$RELEASE_NOTES_SKIP" = "1" ] && exit 0

[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0

case "$(git log -1 --format=%s)" in
  *"[release-notes]"*) exit 0 ;;
esac

# Backgrounding would return the prompt sooner, but the commit it describes
# could be pushed before the notes exist. A few seconds is the honest cost.
node scripts/release-notes.mjs --commit
