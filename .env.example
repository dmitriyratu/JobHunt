# Get your API key from https://platform.openai.com/api-keys
# Local development only — in production each visitor supplies their own key
# in AI settings. See DEPLOY.md.
OPENAI_API_KEY=

# The model for each step is chosen in code, per task (src/lib/models.ts),
# so there is no model env var.

# Optional. When set, every compiled resume's LaTeX source is written here as
# latest.tex, with the previous one kept as previous.tex to diff against.
# Debug aid only - the .tex otherwise exists only in memory and in a temp
# directory that is deleted the moment the compile finishes.
# JOBHUNT_TEX_DIR=
